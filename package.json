{
  "name": "valey",
  "version": "0.58.0",
  "type": "module",
  "description": "A pixel-art office for the agents you already run",
  "homepage": "https://valey.dev",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "author": "Sergei Goriugin (xoyk)",
  "scripts": {
    "start": "node server/supervisor.js",
    "dev": "node server/index.js",
    "update": "node tools/update.mjs",
    "test": "node tools/run-tests.mjs",
    "coverage": "npx --yes c8@10 --reporter=text-summary --reporter=html --src=. --exclude=**/test-*.mjs --exclude=tools/run-tests.mjs --exclude=.claude/** --check-coverage --lines=70 --functions=55 node tools/run-tests.mjs",
    "figma:audit": "node \"$HOME/.claude/skills/agents-init/modules/design-first/scripts/figma-audit.mjs\"",
    "notes": "node tools/notes.mjs",
    "release": "node tools/release.mjs",
    "ship": "node tools/release.mjs --ship",
    "promote": "node tools/promote.mjs",
    "land": "node tools/land.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valey-dev/valey-core.git"
  },
  "bugs": {
    "url": "https://github.com/valey-dev/valey-core/issues"
  }
}
