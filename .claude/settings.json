{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(node --check *)",
      "Bash(node tools/test-*)",
      "Bash(node tools/shot.mjs *)",
      "Bash(node modules/*)"
    ],
    "deny": [
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$HOME/.claude/skills/agents-init/scripts/render-rulebook.mjs\"; if [ -f \"$R\" ]; then node \"$R\" --hook; else true; fi",
            "timeout": 20,
            "statusMessage": "Rendering the rulebook page"
          }
        ]
      }
    ]
  }
}
