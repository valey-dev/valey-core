#!/bin/sh
# The rulebook page never lags the rulebook.
#
# .claude/settings.json rebuilds .claude/rulebook.html on every edit Claude Code
# makes to AGENTS.md. This hook is the same guarantee for every other editor and
# every other agent: whoever commits AGENTS.md commits the page rebuilt from it.
#
# Git does not version hooks, so this is switched on once per clone:
#
#   git config core.hooksPath .githooks
#
# The stamp (.claude/rulebook.json) is deliberately not touched here. A section
# that differs from its stamp is the signal the sync uses to tell "edited here"
# from "the canon moved"; refreshing it on every commit would erase that.
set -e
if git diff --cached --name-only | grep -qx 'AGENTS.md'; then
  R="$HOME/.claude/skills/agents-init/scripts/render-rulebook.mjs"
  if [ -f "$R" ]; then
    node "$R" && git add .claude/rulebook.html
  else
    echo "pre-commit: agents-init skill not found; .claude/rulebook.html was not rebuilt" >&2
  fi
fi
