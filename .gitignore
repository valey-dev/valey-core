.shots/
node_modules/
.settings.json

# правила этого репозитория лежат в .claude/settings.json и коммитятся;
# личные послабления приложение пишет сюда, и они остаются на машине
.claude/settings.local.json

# сборка лендинга для Cloudflare Pages — собирается на их стороне
_site/

# Чужие модули в modules/ — приватные, лежат в своём репозитории и приезжают
# сюда символической ссылкой. Ядро их не хранит и не должно замечать: без этих
# строк они висели бы в git status у каждого, кто их подключил, и однажды кто-то
# добавил бы их сюда «чтобы не мешались».
/modules/*
!/modules/radio/

# Рулбук агентов — AGENTS.md, CLAUDE.md-указатель, BACKLOG.md ядра и штамп
# .claude/rulebook.json — коммитится. До 3 сентября 2026 он был в этом списке:
# «описывает команду, а не офис». Цена оказалась ровно той, что была здесь же
# и записана: worktree выкладывает только отслеживаемые файлы, и агент в ветке
# стартовал с чистого листа. Приватная половина правил с инцидентами по платным
# модулям остаётся в modules/AGENTS.md.
