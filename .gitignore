.shots/
node_modules/
.settings.json

# правила этого репозитория лежат в .claude/settings.json и коммитятся;
# личные послабления приложение пишет сюда, и они остаются на машине
.claude/settings.local.json

# сборка лендинга для Cloudflare Pages — собирается на их стороне
_site/

# Чужие модули в modules/ — приватные, лежат в своём репозитории и приезжают
# сюда символической ссылкой. Ядро их не хранит и не должно замечать: без этих
# строк они висели бы в git status у каждого, кто их подключил, и однажды кто-то
# добавил бы их сюда «чтобы не мешались».
/modules/*
!/modules/radio/

# Рулбук агентов наружу не идёт. Публиковать его незачем: он описывает, как
# работает эта команда, а не как работает офис, и правится он каждый раз, когда
# что-нибудь ломается. Файлы остаются на диске и читаются агентом, но в
# публичную историю не попадают. Версионируется он в приватной половине —
# modules/AGENTS.md.
#
# Цена решения: `git worktree add` для этого репозитория даст дерево БЕЗ них,
# потому что worktree выкладывает только отслеживаемые файлы. Агент, открытый
# в такой ветке, снова начнёт с чистого листа — ровно то, из-за чего девять
# коммитов здесь написаны не по конвенции. Копировать руками.
/AGENTS.md
/CLAUDE.md
